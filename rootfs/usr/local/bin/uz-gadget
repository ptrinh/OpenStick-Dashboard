#!/bin/sh
# uz-gadget status | hid | hid-off | storage <image> [rw|ro|cdrom] | eject | reset | type "text"
# Adds functions to the pmOS USB gadget while KEEPING ncm.usb0 (SSH over USB).
# Rebinding drops USB for ~2 s — run it via:  systemd-run uz-gadget hid
G=$(ls -d /sys/kernel/config/usb_gadget/*/ 2>/dev/null | head -1); G=${G%/}
C=$(ls -d $G/configs/*/ | head -1); C=${C%/}
rebind(){ U=$(cat $G/UDC); [ -z "$U" ] && U=$(ls /sys/class/udc | head -1); echo "" > $G/UDC; sleep 1; "$@"; echo "$U" > $G/UDC; }
add_hid(){
  F=$G/functions/hid.uz; [ -d $F ] || { mkdir $F || { echo "kernel lacks USB_CONFIGFS_F_HID"; exit 1; }
    echo 1 > $F/protocol; echo 1 > $F/subclass; echo 8 > $F/report_length
    printf '\x05\x01\x09\x06\xa1\x01\x05\x07\x19\xe0\x29\xe7\x15\x00\x25\x01\x75\x01\x95\x08\x81\x02\x95\x01\x75\x08\x81\x03\x95\x05\x75\x01\x05\x08\x19\x01\x29\x05\x91\x02\x95\x01\x75\x03\x91\x03\x95\x06\x75\x08\x15\x00\x25\x65\x05\x07\x19\x00\x29\x65\x81\x00\xc0' > $F/report_desc; }
  [ -e $C/hid.uz ] || ln -s $F $C/hid.uz
}
add_storage(){  # $1=image $2=rw|ro|cdrom
  rm -f $C/mass_storage.uz; rmdir $G/functions/mass_storage.uz 2>/dev/null
  F=$G/functions/mass_storage.uz; mkdir $F || { echo "kernel lacks USB_CONFIGFS_MASS_STORAGE"; exit 1; }
  echo 1 > $F/lun.0/removable
  case $2 in ro) echo 1 > $F/lun.0/ro ;; cdrom) echo 1 > $F/lun.0/cdrom; echo 1 > $F/lun.0/ro ;; esac
  echo "$1" > $F/lun.0/file
  ln -s $F $C/mass_storage.uz
}
eject_storage(){ rm -f $C/mass_storage.uz; rmdir $G/functions/mass_storage.uz 2>/dev/null; }
reset_fn(){ for f in hid.uz mass_storage.uz; do rm -f $C/$f; rmdir $G/functions/$f 2>/dev/null; done; }
type_text(){ python3 - "$1" <<'PY'
import sys, time
m = {**{c: (4+i, 0) for i, c in enumerate('abcdefghijklmnopqrstuvwxyz')}, **{c: (4+i, 2) for i, c in enumerate('ABCDEFGHIJKLMNOPQRSTUVWXYZ')},
     **{c: (30+i, 0) for i, c in enumerate('1234567890')}, **{c: (30+i, 2) for i, c in enumerate('!@#$%^&*()')},
     '\n': (40, 0), ' ': (44, 0), '-': (45, 0), '_': (45, 2), '=': (46, 0), '+': (46, 2), '[': (47, 0), '{': (47, 2), ']': (48, 0), '}': (48, 2),
     '\\': (49, 0), '|': (49, 2), ';': (51, 0), ':': (51, 2), "'": (52, 0), '"': (52, 2), '`': (53, 0), '~': (53, 2), ',': (54, 0), '<': (54, 2),
     '.': (55, 0), '>': (55, 2), '/': (56, 0), '?': (56, 2), '\t': (43, 0)}
with open('/dev/hidg0', 'wb', buffering=0) as h:
    for ch in sys.argv[1].replace('\\n', '\n'):
        if ch not in m: continue
        k, mod = m[ch]; h.write(bytes([mod, 0, k, 0, 0, 0, 0, 0])); h.write(bytes(8)); time.sleep(0.01)
PY
}
case $1 in
  status) echo "gadget $G"; ls $C; ls /dev/hidg* 2>/dev/null ;;
  hid) rebind add_hid; echo "HID keyboard on /dev/hidg0" ;;
  hid-off) rebind sh -c "rm -f $C/hid.uz; rmdir $G/functions/hid.uz 2>/dev/null" ;;
  eject) rebind eject_storage ;;
  storage) [ -f "$2" ] || { echo "usage: uz-gadget storage <image> [rw|ro|cdrom]"; exit 1; }; rebind add_storage "$2" "${3:-rw}" ;;
  reset) rebind reset_fn ;;
  type) type_text "$2" ;;
  *) echo "usage: uz-gadget status|hid|hid-off|storage <img> [rw|ro|cdrom]|eject|reset|type \"text\""; exit 1 ;;
esac
