{
  "log": {"level": "warn"},
  "dns": {"servers": [{"tag": "remote", "address": "tls://1.1.1.1", "detour": "vless"}]},
  "inbounds": [{"type": "tun", "interface_name": "tun-uz", "address": ["172.19.0.1/30"],
                "auto_route": true, "auto_redirect": true, "strict_route": true, "sniff": true,
                "route_exclude_address": ["100.64.0.0/10"]}],
  "outbounds": [
    {"type": "vless", "tag": "vless", "server": "CHANGE_ME_DDNS_HOST", "server_port": 443,
     "uuid": "CHANGE_ME_UUID", "flow": "xtls-rprx-vision",
     "tls": {"enabled": true, "server_name": "CHANGE_ME_SNI",
